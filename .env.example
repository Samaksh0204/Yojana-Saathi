# Copy to .env and fill in. Everything is optional: with no keys the app runs in
# offline mode (rule-based English/Hindi understanding, template replies, no voice).

# --- Claude: understands any Indian language and writes the replies ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# LLM_MODE=auto            # auto | on | off

# --- Voice (Whisper). Free option: pip install faster-whisper (runs on this machine).
# Hosted option: an OpenAI key. ---
# OPENAI_API_KEY=
# STT_PROVIDER=auto        # auto | openai | local | off

# --- WhatsApp through Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL of this server; Twilio signs requests against it.
PUBLIC_BASE_URL=
# TWILIO_VALIDATE_SIGNATURE=true   # never turn this off in production

# --- Hardening ---
SESSION_SECRET=change-me-to-a-long-random-string
# RATE_LIMIT_PER_MINUTE=30
# SESSION_TTL_DAYS=30
# CORS_ORIGINS=https://your-frontend.example
# VECTOR_SEARCH=auto       # set to off on very small servers (BM25 search still works)
