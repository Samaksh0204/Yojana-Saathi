{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Yojana Saathi: web",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "Yojana Saathi: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Yojana Saathi: terminal chat",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.chat",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
